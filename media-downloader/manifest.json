{
  "manifest_version": 3,
  "name": "音视频下载",
  "version": "0.2.0",
  "description": "通用音视频嗅探下载：支持 mp3/m4a/flac/wav/ogg/opus 等音频、mp4/webm 等视频，以及 HLS 流；对抖音、B 站、网易云、QQ 音乐额外做文案提取与文件命名优化。",
  "minimum_chrome_version": "111",
  "permissions": ["webRequest", "downloads", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "查看当前页面的音视频",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
